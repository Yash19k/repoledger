# ---- Database (PostgreSQL / Supabase) ----
# Direct connection (requires IPv6)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Transaction Pooler (use if your network does not support IPv6)
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ---- Server ----
PORT=8600
# The address people use to reach the site (used for sign-in redirects and secure cookies).
PUBLIC_URL=http://localhost:8600
# Optional: link to the source code, shown on the landing page.
SOURCE_URL=

# ---- GitHub App (filled in by `npm run create-app`) ----
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=

# ---- Public username lookups ----
# A GitHub token with NO scopes (Settings > Developer settings > Personal access tokens).
# Raises GitHub's limit from 60 to 5,000 requests per hour.
GITHUB_PUBLIC_TOKEN=
