{
  "name": "repoledger",
  "version": "0.2.0",
  "private": true,
  "description": "GitHub traffic, kept for good. Look up any user's public stats, or sign in to keep your own views and clones past GitHub's 14-day limit.",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "collect": "node src/collector.js",
    "init-db": "node scripts/init-db.js",
    "create-app": "node scripts/create-github-app.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "plotly.js-strict-dist-min": "^3.7.0"
  }
}
